{
  "name": "xpowerpoint-mcp",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "XPowerpoint MCP server: full-control PowerPoint skill suite (v2.0.0)",
  "bin": {
    "xpowerpoint-mcp": "bin/server.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node bin/server.mjs",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/e2e/smoke.mjs",
    "test:mcp": "node tests/e2e/mcp_client.mjs",
    "test:extended": "node tests/e2e/extended.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "pptxgenjs": "^3.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
