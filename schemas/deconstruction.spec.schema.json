{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpowerpoint.local/schemas/deconstruction.spec.schema.json",
  "title": "DeconstructionSpec",
  "type": "object",
  "required": ["sourceId", "technique"],
  "properties": {
    "sourceId": { "type": "string" },
    "technique": {
      "enum": ["boolean-fragment", "grid-slice", "path-slice", "strip", "peel", "explode",
        "scatter", "layer-offset", "cutout", "mask-window", "kinetic-type", "cover-reveal",
        "broken-grid", "halftone", "shatter"]
    },
    "params": { "type": "object" },
    "pieces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sourceRef": { "type": "string" },
          "geometry": { "type": "object" },
          "index": { "type": "integer" },
          "color": { "type": "string" },
          "rotation": { "type": "number" }
        }
      }
    },
    "group": { "type": "string", "pattern": "^deco/" },
    "editSourceGroup": { "type": "string", "default": "edit-source/original" },
    "bake": { "type": "boolean", "default": false }
  },
  "additionalProperties": true
}
