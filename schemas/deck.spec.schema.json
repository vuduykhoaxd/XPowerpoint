{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpowerpoint.local/schemas/deck.spec.schema.json",
  "title": "DeckSpec",
  "type": "object",
  "required": ["version", "meta", "slides"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "subject": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "language": { "type": "string", "default": "vi" },
        "size": {
          "type": "object",
          "properties": {
            "w": { "type": "number", "default": 13.333 },
            "h": { "type": "number", "default": 7.5 },
            "unit": { "enum": ["in", "cm", "pt"], "default": "in" }
          }
        },
        "theme": { "type": "string" },
        "style": { "type": "string" }
      }
    },
    "brief": { "$ref": "brief.schema.json" },
    "tokens": { "$ref": "tokens.schema.json" },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "slide.spec.schema.json" } },
    "assets": { "type": "array", "items": { "$ref": "asset.schema.json" } },
    "sections": { "type": "array", "items": { "type": "object" } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
