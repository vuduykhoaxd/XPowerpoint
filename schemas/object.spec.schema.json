{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpowerpoint.local/schemas/object.spec.schema.json",
  "title": "ObjectSpec",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": { "type": "string", "pattern": "^(bg|deco|content|data|ui|note|edit-source)/[A-Za-z0-9._-]+$" },
    "type": {
      "enum": ["shape", "text", "image", "icon", "group", "line", "table", "chart", "diagram",
        "video", "audio", "model3d", "ole", "equation", "placeholder"]
    },
    "shape": { "enum": ["rect", "roundRect", "ellipse", "triangle", "polygon", "freeform", "curve", "arrow"] },
    "role": { "enum": ["title", "subtitle", "body", "label", "value", "unit", "icon", "container", "connector", "decor", "source", "ui", "h1", "h2"] },
    "band": { "enum": ["bg", "deco", "content", "data", "ui", "note", "edit-source"] },
    "geometry": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["in", "cm", "pt"], "default": "in" },
        "rotation": { "type": "number", "default": 0 }
      }
    },
    "fill": {
      "type": ["object", "null"],
      "properties": {
        "type": { "enum": ["solid", "gradient", "picture", "pattern", "none"] },
        "color": { "type": "string" },
        "stops": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "number"] }, "minItems": 2, "maxItems": 2 } },
        "angle": { "type": "number" },
        "alpha": { "type": "number", "minimum": 0, "maximum": 100 },
        "assetId": { "type": "string" }
      }
    },
    "line": {
      "type": ["object", "null"],
      "properties": {
        "color": { "type": "string" },
        "width": { "type": "number", "minimum": 0 },
        "dash": { "enum": ["solid", "dash", "dot", "dashDot", "lgDash", "sysDash", "sysDot"] },
        "alpha": { "type": "number", "minimum": 0, "maximum": 100 },
        "beginArrow": { "type": "string" },
        "endArrow": { "type": "string" }
      }
    },
    "effects": { "type": "object" },
    "text": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": "string" },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runs": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" }, "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "color": { "type": "string" }, "fontSize": { "type": "number" } } } },
              "align": { "enum": ["left", "center", "right", "justify"] },
              "bullet": { "type": ["boolean", "object"] },
              "level": { "type": "integer", "minimum": 0, "maximum": 5 },
              "lineSpacing": { "type": "number" }
            }
          }
        },
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number", "minimum": 1 },
        "color": { "type": "string" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "valign": { "enum": ["top", "middle", "bottom"] },
        "lineSpacing": { "type": "number" },
        "letterSpacing": { "type": "number" },
        "autofit": { "enum": ["none", "shrink", "resize"] },
        "margin": { "type": "number" },
        "wrap": { "type": "boolean" }
      }
    },
    "image": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": "string" },
        "assetId": { "type": "string" },
        "data": { "type": "string" },
        "crop": { "type": "object" },
        "mask": { "type": "string" },
        "duotone": { "type": "array", "items": { "type": "string" } },
        "fit": { "enum": ["cover", "contain", "stretch"] }
      }
    },
    "chart": {
      "type": ["object", "null"],
      "properties": {
        "type": { "enum": ["bar", "column", "line", "area", "pie", "donut", "scatter", "bubble", "radar", "combo", "waterfall", "funnel"] },
        "title": { "type": "string" },
        "labels": { "type": "array", "items": { "type": ["string", "number"] } },
        "series": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "values": { "type": "array", "items": { "type": "number" } }, "color": { "type": "string" }, "type": { "type": "string" } } } },
        "options": { "type": "object" },
        "dataRef": { "type": "string" }
      }
    },
    "table": {
      "type": ["object", "null"],
      "properties": {
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "header": { "type": "boolean" },
        "colWidths": { "type": "array", "items": { "type": "number" } },
        "zebra": { "type": "boolean" },
        "options": { "type": "object" }
      }
    },
    "media": { "type": "object" },
    "children": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "object" } },
    "style": { "type": "object" },
    "z": { "type": "integer", "minimum": 0, "maximum": 999 },
    "decorative": { "type": "boolean", "default": false },
    "altText": { "type": "string", "maxLength": 250 },
    "sourceRef": { "type": ["string", "null"] },
    "locked": { "type": "boolean", "default": false },
    "intentionalOverlap": { "type": "boolean", "default": false },
    "cf": { "type": "object" }
  },
  "additionalProperties": true
}
